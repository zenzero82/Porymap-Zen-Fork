modules = ["nodejs-24"]
[nix]
channel = "stable-25_05"
packages = ["qt6.qtbase", "qt6.qtdeclarative", "qt6.qtcharts", "gnumake", "libglvnd"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Porymap"

[[workflows.workflow]]
name = "Porymap"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "./scripts/replit-run.sh"

[workflows.workflow.metadata]
outputType = "vnc"
